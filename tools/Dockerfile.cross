# Cross-compile the workspace for aarch64 (Jetson) from an x86 host.
#
#   docker build -f tools/Dockerfile.cross -t edge-vision-cross .
#   docker run --rm -v "$PWD:/work" edge-vision-cross \
#       cargo build --release --target aarch64-unknown-linux-gnu
#
# This covers the platform-independent workspace and platform-sim.
# platform-jetson (M1+) additionally needs the L4T sysroot from the
# pinned JetPack mounted in; extend this image then.
# Aligned with the camera Yocto image's OE-core Rust (1.98.1), so
# cross builds and image builds see the same compiler generation.
FROM rust:1.98-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc-aarch64-linux-gnu g++-aarch64-linux-gnu libc6-dev-arm64-cross \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add aarch64-unknown-linux-gnu \
    && rustup component add rustfmt clippy

ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar
WORKDIR /work
