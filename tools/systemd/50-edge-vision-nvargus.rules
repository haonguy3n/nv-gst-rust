// NOT USED: the camera images have no polkit (the recipe installs edge-vision-control.socket instead, a root
// helper the app reaches over a unix socket). Kept for a future image that has polkit: install it as
// /etc/polkit-1/rules.d/50-edge-vision-nvargus.rules and verify first.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "nvargus-daemon.service" &&
        action.lookup("verb") == "restart" &&
        subject.user == "edge-vision") {
        return polkit.Result.YES;
    }
});
